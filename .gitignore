.DS_Store

# User-generated works stay local unless explicitly selected for publication.
works/**
!works/.gitkeep

# Keep all accumulated content under the project-root library local; only its public guide may be tracked.
# This covers future exports, manifests, databases, media and unknown subdirectories as well as canonical records.
/benchmark/**
!/benchmark/README.md

# Narrow record/cache patterns document current formats and remain compatible with older checkouts.
/benchmark/sources/
/benchmark/*/atoms/
/benchmark/*/usage/
/benchmark/*/index.sqlite3*
/benchmark/*/.index.sqlite3.*.tmp
/benchmark/.transactions/
/benchmark/.library.lock/
/benchmark/.library.lock.stale-*/
/benchmark/.*.tmp

# Local runtime and temporary files
.tmp/
tmp/
output/
.cache/
*.log

# Local environments and secrets
.env
.env.*
!.env.example

# Language and tool caches
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
node_modules/
coverage/
dist/
build/

# Editor and operating-system files
.vscode/
.idea/
*.swp
*.swo

# Machine-local global Skill registrations
.laohu-install.json
.laohu-install.lock
.laohu-install-*.tmp

# Maintainer-only publishing workflow; never distribute
.agents/skills/laohu-publish/
