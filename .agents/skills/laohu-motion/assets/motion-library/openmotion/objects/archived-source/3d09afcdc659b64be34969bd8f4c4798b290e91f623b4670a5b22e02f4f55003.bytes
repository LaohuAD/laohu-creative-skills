  "id": "sequence",
  "title": "整体编排",
  "src": "demos/sequence.html",
  "duration": 9.216667,
  "status": "authored",
  "description": "动作与构图示意",
  "initialTime": 2.1,
  "params": [
    {
      "key": "title",
      "label": "示例主文案",
      "type": "text",
      "value": "THE MAKING\nOF CLAUDE CODE",
      "maxLength": 60
    },
    {
      "key": "accent",
      "label": "强调色",
      "type": "color",
      "value": "#cc7863"
    }
  ],
  "presets": [
    {
      "label": "默认内容",
