{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "source.schema.json",
  "title": "Benchmark source record",
  "type": "object",
  "required": ["schema_version", "source_id", "identity", "provenance", "source_material", "evidence_status"],
  "properties": {
    "schema_version": {"const": 1},
    "source_id": {"type": "string", "pattern": "^SRC-[A-F0-9]{16}$"},
    "identity": {
      "type": "object",
      "required": ["title", "creator", "medium", "version"],
      "properties": {
        "title": {"type": "string", "minLength": 1},
        "creator": {"type": "string", "minLength": 1},
        "medium": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1}
      },
      "additionalProperties": true
    },
    "provenance": {
      "type": "object",
      "required": ["identity_basis", "locator", "access_scope"],
      "properties": {
        "identity_basis": {"type": "string", "minLength": 1},
        "locator": {"type": "string", "minLength": 1},
        "access_scope": {"type": "string", "minLength": 1},
        "checked_at": {"type": "string"},
        "independent_units": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "unit": {"type": "string", "minLength": 1},
              "title": {"type": "string"},
              "disposition": {"type": "string"},
              "locator": {"type": "string"},
              "analysis": {},
              "index_card": {
                "type": "object",
                "required": ["title", "summary"],
                "properties": {
                  "title": {"type": "string", "minLength": 1},
                  "summary": {"type": "string", "minLength": 1, "maxLength": 200},
                  "terms": {"type": "array", "items": {"type": "string", "minLength": 1}}
                },
                "additionalProperties": false
              },
              "verified_span": {
                "type": "object",
                "required": ["source_version", "start", "end", "sha256"],
                "properties": {
                  "source_version": {"type": "string", "minLength": 1},
                  "start": {"type": "integer", "minimum": 0},
                  "end": {"type": "integer", "minimum": 1},
                  "sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"}
                },
                "additionalProperties": false
              }
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    },
    "source_material": {
      "type": "object",
      "required": ["reference_kind", "reference", "version", "read_scope"],
      "properties": {
        "reference_kind": {"enum": ["user-provided-text", "user-file", "public-source", "licensed-copy", "media-source", "other"]},
        "reference": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "read_scope": {"type": "string", "minLength": 1},
        "captured_excerpt": {"type": "string", "minLength": 1},
        "content_sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"}
      },
      "allOf": [
        {"if": {"properties": {"reference_kind": {"const": "user-provided-text"}}, "required": ["reference_kind"]},
         "then": {"required": ["captured_excerpt"]}}
      ],
      "additionalProperties": false
    },
    "evidence_status": {"enum": ["candidate", "identity-checked", "unit-located", "context-readable", "limited"]},
    "work_family_id": {"type": "string"},
    "notes": {"type": "string"},
    "added_at": {"type": "string"}
  },
  "additionalProperties": false
}
